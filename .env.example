# development | production
APP_ENV=development
# debug | info | warn | error; по умолчанию debug в development и info в production
LOG_LEVEL=

# локально VK ID редиректит только на http://localhost без порта, поэтому :80
HTTP_ADDR=:80
HTTP_READ_HEADER_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s
HEALTH_TIMEOUT=2s
# IP или подсети через запятую; пусто — заголовкам X-Forwarded-For не доверяем
HTTP_TRUSTED_PROXIES=

DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable
DB_CONNECT_TIMEOUT=5s

TG_BOT_TOKEN=
# куда callback возвращает пользователя: ссылка на Mini App (https://t.me/<бот>/<app>)
# или, пока Mini App нет, на бота (https://t.me/<бот>); к ней добавляется ?startapp=<результат>
TG_MINIAPP_URL=
# сколько живёт initData Mini App: Telegram не обновляет его, пока приложение открыто
TG_INITDATA_MAX_AGE=24h

VKID_CLIENT_ID=
VKID_AUTH_URL=https://id.vk.ru/authorize
VKID_TOKEN_URL=https://id.vk.ru/oauth2/auth
VKID_USERINFO_URL=https://id.vk.ru/oauth2/user_info
VKID_LOGOUT_URL=https://id.vk.ru/oauth2/logout
VKID_HTTP_TIMEOUT=10s
VKID_REDIRECT_URL=http://localhost/oauth/callback
# vkid.personal_info email phone
VKID_SCOPES=vkid.personal_info email
# mail_ru | ok_ru | vkid
VKID_PROVIDER=mail_ru
OAUTH_STATE_TTL=10m
