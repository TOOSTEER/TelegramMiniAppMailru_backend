    "author_id": 9,
    "parent_comment_id": null,
    "root_comment_id": 23,
    "reply_to_user_id": null,
    "depth": 0,
    "text": "По ощущениям при активном использовании хватает недели на две.",
    "upvotes_count": 6,
    "downvotes_count": 1,
    "rating": 5,
    "replies_count": 0,
    "descendants_count": 0,
    "is_edited": false,
    "is_deleted": false,
    "created_at": "2026-10-09T10:00:00Z",
    "updated_at": "2026-10-09T10:00:00Z"
  },
  {
