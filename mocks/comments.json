    "parent_comment_id": null,
    "root_comment_id": 25,
    "reply_to_user_id": null,
    "depth": 0,
    "text": "И не забывайте, что это нагрузка на лёгкие. Если получится, лучше сокращать количество.",
    "upvotes_count": 11,
    "downvotes_count": 2,
    "rating": 9,
