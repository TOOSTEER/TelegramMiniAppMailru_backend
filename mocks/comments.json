    "author_id": 8,
    "parent_comment_id": null,
    "root_comment_id": 24,
    "reply_to_user_id": null,
    "depth": 0,
    "text": "Зависит от мощности и привычек. При частых затяжках меньше, чем заявлено.",
    "upvotes_count": 5,
    "downvotes_count": 2,
    "rating": 3,
    "replies_count": 0,
    "descendants_count": 0,
    "is_edited": false,
    "is_deleted": false,
    "created_at": "2026-10-10T11:58:00Z",
    "updated_at": "2026-10-10T11:58:00Z"
  },
  {
